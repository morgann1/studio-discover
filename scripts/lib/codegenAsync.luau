--!strict

const fs = require("@std/fs")
const process = require("@lute/process")

const project = require("@root/project")
const readPluginVersionAsync = require("@scripts/lib/readPluginVersionAsync")
const runAsync = require("@scripts/lib/runAsync")

const DEV_ICON = "rbxassetid://132814924850541"
const RELEASE_ICON_LIGHT = "rbxassetid://130636941180756"
const RELEASE_ICON_DARK = "rbxassetid://125390421270921"
const RELEASE_ICON_MONO = "rbxassetid://110255059905069"

export type Options = {
	read dev: boolean?,
	read sourcemap: boolean?,
}

-- Outside a git checkout this is empty, and the About screen shows the version alone.
const function readCommitShaAsync(): string
	const result = process.run({ "git", "rev-parse", "--short", "HEAD" })
	if not result.ok then
		return ""
	end

	return (string.gsub(result.stdout, "%s+$", ""))
end

const function quote(value: string): string
	const escaped = string.gsub(string.gsub(value, "\\", "\\\\"), '"', '\\"')
	return `"{escaped}"`
end

--[[
	Renders `plugin/generated/buildConfig.luau`, the identity a build installs under.

	The dev build gets its own toolbar, widget, and plugin-settings identity so it
		installs alongside the release build. Widget titles carry the version so dock
		state persists per version, the way Rojo does it.
]]
const function renderBuildConfig(dev: boolean, version: string, commit: string): string
	const suffix = if dev then " (Dev)" else ""
	const widgetTitle = `Discover {version}{suffix}`

	const fields: { { read name: string, read value: string } } = {
		{ name = "pluginName", value = `Discover{suffix}` },
		{ name = "widgetId", value = widgetTitle },
		{ name = "widgetTitle", value = widgetTitle },
		{ name = "widgetName", value = widgetTitle },
		{ name = "buttonId", value = if dev then "discover-dev" else "discover" },
		{ name = "buttonTitle", value = `Discover{suffix}` },
		{
			name = "buttonTooltip",
			value = if dev then "Browse and install Luau packages (dev build)" else "Browse and install Luau packages",
		},
		{ name = "peerId", value = if dev then "morgann1/studio-discover-dev" else "morgann1/studio-discover" },
		{ name = "toolbarTitle", value = if dev then "22:43 (Dev)" else "22:43" },
		{ name = "mediumName", value = if dev then "  22:43 Plugin Suite (Dev)" else "  22:43 Plugin Suite" },
		{ name = "commit", value = commit },
	}

	const lines = {
		"--!strict",
		"-- This file is @generated by scripts/lib/codegenAsync.luau. Do not edit.",
		"",
		'type IconRamp = { { size: number, variants: { ["light" | "dark" | "mono"]: string } } }',
		"",
		"return table.freeze({",
		`\tisDev = {dev},`,
	}

	for _, field in fields do
		table.insert(lines, `\t{field.name} = {quote(field.value)},`)
	end

	table.insert(lines, "\ticon = ({")
	table.insert(lines, "\t\t{")
	table.insert(lines, "\t\t\tsize = 64,")
	table.insert(lines, "\t\t\tvariants = {")
	table.insert(lines, `\t\t\t\tlight = {quote(if dev then DEV_ICON else RELEASE_ICON_LIGHT)},`)
	table.insert(lines, `\t\t\t\tdark = {quote(if dev then DEV_ICON else RELEASE_ICON_DARK)},`)
	table.insert(lines, `\t\t\t\tmono = {quote(if dev then DEV_ICON else RELEASE_ICON_MONO)},`)
	table.insert(lines, '\t\t\t} :: { ["light" | "dark" | "mono"]: string },')
	table.insert(lines, "\t\t},")
	table.insert(lines, "\t}) :: IconRamp,")
	table.insert(lines, "})")
	table.insert(lines, "")

	return table.concat(lines, "\n")
end

--[[
	Writes everything under `plugin/generated/` that the Rojo projects mount.

	The sourcemap is opt-in because Rojo cannot map the plugin project until
		`plugin/Packages` exists, and a build has no use for one.
]]
const function codegenAsync(options: Options?): ()
	const dev = options ~= nil and options.dev == true
	const sourcemap = options ~= nil and options.sourcemap == true

	fs.createDirectory(project.GENERATED_PATH, { makeParents = true })
	fs.writeStringToFile(
		project.BUILD_CONFIG_PATH,
		renderBuildConfig(dev, readPluginVersionAsync(), readCommitShaAsync())
	)

	if sourcemap then
		runAsync("rojo", {
			"sourcemap",
			project.PROJECT_PATH,
			"--output",
			project.SOURCEMAP_PATH,
			"--include-non-scripts",
			"--absolute",
		})
	end
end

return codegenAsync

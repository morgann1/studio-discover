--!strict

local fs = require("@std/fs")
local process = require("@lute/process")

local project = require("@root/project")
local run = require("@scripts/lib/run")

local DEV_ICON = "rbxassetid://132814924850541"
local RELEASE_ICON_LIGHT = "rbxassetid://130636941180756"
local RELEASE_ICON_DARK = "rbxassetid://125390421270921"
local RELEASE_ICON_MONO = "rbxassetid://110255059905069"

export type Options = {
	dev: boolean?,
	sourcemap: boolean?,
}

local function readPluginVersion(): string
	local contents = fs.readFileToString(project.WALLY_TOML_PATH)

	local version = string.match(contents, 'version%s*=%s*"([^"]+)"')
	if version == nil then
		error(`Could not read the version from {project.WALLY_TOML_PATH}`, 0)
	end

	return version
end

-- Outside a git checkout this is empty, and the About screen shows the version alone.
local function readCommitSha(): string
	local result = process.run({ "git", "rev-parse", "--short", "HEAD" })
	if not result.ok then
		return ""
	end

	return (string.gsub(result.stdout, "%s+$", ""))
end

local function quote(value: string): string
	local escaped = string.gsub(string.gsub(value, "\\", "\\\\"), '"', '\\"')
	return `"{escaped}"`
end

--[[
	Renders `plugin/generated/buildConfig.luau`, the identity a build installs under.

	The dev build gets its own toolbar, widget, and plugin-settings identity so it
		installs alongside the release build. Widget titles carry the version so dock
		state persists per version, the way Rojo does it.
]]
local function renderBuildConfig(dev: boolean, version: string, commit: string): string
	local suffix = if dev then " (Dev)" else ""
	local widgetTitle = `Discover {version}{suffix}`

	local fields: { { string } } = {
		{ "pluginName", `Discover{suffix}` },
		{ "widgetId", widgetTitle },
		{ "widgetTitle", widgetTitle },
		{ "widgetName", widgetTitle },
		{ "buttonId", if dev then "discover-dev" else "discover" },
		{ "buttonTitle", `Discover{suffix}` },
		{
			"buttonTooltip",
			if dev then "Browse and install Luau packages (dev build)" else "Browse and install Luau packages",
		},
		{ "peerId", if dev then "morgann1/studio-discover-dev" else "morgann1/studio-discover" },
		{ "toolbarTitle", if dev then "22:43 (Dev)" else "22:43" },
		{ "mediumName", if dev then "  22:43 Plugin Suite (Dev)" else "  22:43 Plugin Suite" },
		{ "commit", commit },
	}

	local lines = {
		"--!strict",
		"-- This file is @generated by scripts/lib/codegen.luau. Do not edit.",
		"",
		'type IconRamp = { { size: number, variants: { ["light" | "dark" | "mono"]: string } } }',
		"",
		"return table.freeze({",
		`\tisDev = {dev},`,
	}

	for _, field in fields do
		table.insert(lines, `\t{field[1]} = {quote(field[2])},`)
	end

	table.insert(lines, "\ticon = ({")
	table.insert(lines, "\t\t{")
	table.insert(lines, "\t\t\tsize = 64,")
	table.insert(lines, "\t\t\tvariants = {")
	table.insert(lines, `\t\t\t\tlight = {quote(if dev then DEV_ICON else RELEASE_ICON_LIGHT)},`)
	table.insert(lines, `\t\t\t\tdark = {quote(if dev then DEV_ICON else RELEASE_ICON_DARK)},`)
	table.insert(lines, `\t\t\t\tmono = {quote(if dev then DEV_ICON else RELEASE_ICON_MONO)},`)
	table.insert(lines, '\t\t\t} :: { ["light" | "dark" | "mono"]: string },')
	table.insert(lines, "\t\t},")
	table.insert(lines, "\t}) :: IconRamp,")
	table.insert(lines, "})")
	table.insert(lines, "")

	return table.concat(lines, "\n")
end

--[[
	Writes everything under `plugin/generated/` that the Rojo projects mount.

	The sourcemap is opt-in because Rojo cannot map the plugin project until
		`plugin/Packages` exists, and a build has no use for one.
]]
local function codegen(options: Options?)
	local dev = options ~= nil and options.dev == true
	local sourcemap = options ~= nil and options.sourcemap == true

	fs.createDirectory(project.GENERATED_PATH, { makeParents = true })
	fs.writeStringToFile(project.BUILD_CONFIG_PATH, renderBuildConfig(dev, readPluginVersion(), readCommitSha()))

	if sourcemap then
		run("rojo", {
			"sourcemap",
			project.PROJECT_PATH,
			"--output",
			project.SOURCEMAP_PATH,
			"--include-non-scripts",
			"--absolute",
		})
	end
end

return codegen

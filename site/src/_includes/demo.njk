{#- The Discover widget, rebuilt for the demo. Every view the script reaches is here, and the
    attributes on .demo pick which one shows. Without the script, the page shows this final
    frame: expanded, light, on Installed, with the updates applied. -#}
{%- set glyphs = {
  "back": "F123", "fwd": "F124", "down": "F126", "dots": "F1F9", "check": "F120", "sidebar": "F1DB",
  "search": "F182", "refresh": "F10F", "gear": "F15C", "info": "F12B", "x": "F21C"
} -%}
{%- macro icon(name) -%}<span class="ic">&#x{{ glyphs[name] }};</span>{%- endmacro -%}
{%- macro mark(source, size) -%}
<img class="mark" src="{{ ("/assets/" + source + ".png") | url }}" alt="" width="{{ size }}" height="{{ size }}">
{%- endmacro -%}
<div class="demo" data-theme="light" data-location="installed" data-progress="done">
  <div class="win" style="--w: 960px">
    <div class="titlebar">Discover{{ icon("x") }}</div>
    <div class="app">
      <nav class="side">
        <div class="side-top"><span class="tool">{{ icon("sidebar") }}</span><span class="pill">{{ icon("search") }}Search all sources</span></div>
        <div class="group">This place</div>
        <div class="loc" data-for="installed">Installed<span class="count">5</span></div>
        <div class="loc">Updates<span class="count emphasis updates">2</span></div>
        <div class="group">Sources</div>
        <div class="loc" data-for="wally">{{ mark("wally", 18) }}Wally</div>
        <div class="loc">{{ mark("pesde", 18) }}pesde</div>
      </nav>
      <div class="main">
        <header class="head">
          <span class="tool wide dim">{{ icon("back") }}</span><span class="tool wide dim">{{ icon("fwd") }}</span>
          <span class="title">
            <span class="for-wally">{{ mark("wally", 20) }}Wally</span><span class="for-installed">Installed</span>{{ icon("down") }}
          </span>
          <span class="tool push">{{ icon("refresh") }}</span><span class="tool">{{ icon("gear") }}</span>
        </header>
        <div class="search">
          <span class="pill">{{ icon("search") }}<span class="for-wally">Search Wally</span><span class="for-installed">Search this place</span></span>
        </div>
        <div class="view for-wally">
          <div class="table-head"><span>Name</span><span>Latest</span><span class="wide">Author</span><span class="wide">Status</span></div>
          {%- for pkg in demo.wally %}
          <div class="table-row">
            <span class="name">{{ pkg.name }}</span><span>{{ pkg.latest }}</span><span class="wide">{{ pkg.author }}</span>
            <span class="wide">
              {%- if pkg.status == "update" %}<span class="status"><i class="emphasis"></i>Update</span>
              {%- elif pkg.status == "installed" %}<span class="status"><i class="success"></i>Installed</span>{% endif -%}
            </span>
          </div>
          {%- endfor %}
        </div>
        <div class="view for-installed">
          <div class="alert">
            <span class="alert-icon">{{ icon("info") }}</span>
            <span class="alert-text">
              <span data-step="idle">2 updates available</span>
              {%- for message in demo.progress %}<span data-step="{{ loop.index0 }}">{{ message }}</span>{% endfor -%}
            </span>
            <span class="button" data-step="idle">Update all</span>
          </div>
          <div class="table-head roots"><span>Name</span><span>Version</span><span>Source</span><span></span></div>
          {%- for realm in demo.realms %}
          <div class="realm"><b>{{ realm.name }}</b><span class="path">{{ realm.path }}</span></div>
          {%- for root in realm.roots %}
          <div class="root">
            <span class="name">{{ root.name }}</span>
            <span class="meta">
              {%- if root.update %}
              <span class="version before"><span class="link">{{ root.version }} → {{ root.update }}</span>
                {%- if root.major %}<span class="status box"><i class="warning"></i>Major</span>{% endif %}</span>
              <span class="version after">{{ root.update }}</span>
              {%- else %}
              <span class="version">{{ root.version }}</span>
              {%- endif %}
              <span class="source">{{ mark(root.source, 16) }}{{ "Wally" if root.source == "wally" else "pesde" }}</span>
            </span>
            <span class="action">
              {%- if root.update %}<span class="button small before" data-step="idle">Update</span>{% endif -%}
              <span class="tool more{{ ' after' if root.update }}">{{ icon("dots") }}</span>
            </span>
          </div>
          {%- endfor %}
          {%- endfor %}
        </div>
      </div>
      <div class="menu">
        <div class="group">This place</div>
        <div class="loc">Installed<span class="count">5</span></div>
        <div class="loc">Updates<span class="count emphasis">2</span></div>
        <div class="divider"></div>
        <div class="group">Sources</div>
        <div class="loc current">{{ mark("wally", 18) }}Wally{{ icon("check") }}</div>
        <div class="loc">{{ mark("pesde", 18) }}pesde</div>
      </div>
    </div>
  </div>
  <svg class="cursor" viewBox="0 0 20 20" width="20" height="20">
    <path d="M4 1.5v15.2l4-3.9 2.7 5.9 2.6-1.2-2.7-5.8h5.6z" fill="#fff" stroke="#121215" stroke-width="1.2" stroke-linejoin="round" />
  </svg>
</div>

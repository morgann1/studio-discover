{
  "name": "StudioDiscover",
  "globIgnorePaths": [
    "Packages/**/__tests__",
    "Packages/**/*.spec.lua",
    "Packages/**/*.spec.luau",
    "Packages/**/*.story.lua",
    "Packages/**/*.story.luau",
    "Packages/**/*.storybook.lua",
    "Packages/**/*.storybook.luau"
  ],
  "tree": {
    "$className": "Folder",
    "Main": {
      "$path": "bin/Main.plugin.luau"
    },
    "Source": {
      "$path": "src/",
      "buildConfig": {
        "$path": "generated/buildConfig.luau"
      }
    },
    "Libraries": {
      "$className": "Folder",
      "Core": {
        "$path": "../packages/core/src"
      },
      "PackageTypes": {
        "$path": "../packages/package-types/src"
      },
      "PesdeRegistry": {
        "$path": "../packages/pesde-registry/src"
      },
      "Semver": {
        "$path": "../packages/semver/src"
      },
      "WallyRegistry": {
        "$path": "../packages/wally-registry/src"
      }
    },
    "Packages": {
      "$path": "Packages/"
    }
  }
}
